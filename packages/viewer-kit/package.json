{
	"name": "@aryagg/viewer-kit",
	"version": "0.0.1",
	"description": "Extensible Svelte 5 viewers for documents, Office files, and BIM/CAD models.",
	"type": "module",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"scripts": {
		"dev": "vite dev --port 5173",
		"build": "npm run prepack",
		"prepack": "svelte-package && publint",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"three": "^0.185.0"
	},
	"devDependencies": {
		"@aryagg/theme": "^0.0.3",
		"@eslint/js": "^10.0.1",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^22.20.1",
		"@types/three": "^0.185.4",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.21",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^7.3.6"
	},
	"keywords": [
		"svelte",
		"pdf",
		"ppt",
		"pptx",
		"file-viewer"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iron-throne/skeleton-packages.git",
		"directory": "packages/viewer-kit"
	}
}
