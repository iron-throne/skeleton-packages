{
	"compilerOptions": {
		"allowJs": true,
		"allowArbitraryExtensions": true,
		"checkJs": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,

		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noEmit": true,
		"lib": ["esnext", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],

		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"],
			"$atoms": ["./src/lib/atoms"],
			"$atoms/*": ["./src/lib/atoms/*"],
			"$molecules": ["./src/lib/molecules"],
			"$molecules/*": ["./src/lib/molecules/*"],
			"$organisms": ["./src/lib/organisms"],
			"$organisms/*": ["./src/lib/organisms/*"]
		}
	},
	"include": ["src/**/*.js", "src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
